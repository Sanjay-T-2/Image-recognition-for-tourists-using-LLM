# Optional: enables photo -> place identification.
# Works with any OpenAI-compatible chat completions API, e.g. OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=google/gemma-4-26b-a4b-it:free
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
VISION_TIMEOUT=90

# Set to 1 to run fully offline with the built-in demo dataset
OFFLINE_MODE=0

CORS_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=3600
